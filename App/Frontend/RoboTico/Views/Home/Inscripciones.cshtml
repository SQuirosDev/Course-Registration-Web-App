@model RoboTico.Modelos.ViewModels.InscripcionesVM
@{
    ViewBag.Title = "RoboTico - Inscripción";
}

<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>@ViewBag.Title</title>

        <!-- Bootstrap CSS completo -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

        <!-- CSS propio -->
        <link rel="stylesheet" href="~/styles/inscripciones.css">

        <!-- Favicon -->
        <link rel="icon" href="~/img/Logo RoboTico 4.png" type="image/png">
    </head>
    <body class="bg-light">

        <!-- Formulario -->
        <div class="container my-5 pt-5">
            <div class="row justify-content-center">
                <div class="col-md-6 col-lg-5">
                    <div class="card shadow rounded-4">
                        <div class="card-body p-4">
                            <h2 class="text-center mb-4 fw-bold">Formulario de Inscripción</h2>

                            <!-- Mostrar Aciertos -->
                            @if (Model.ListaAciertos != null && Model.ListaAciertos.Any())
                            {
                                <div class="alert alert-success">
                                    <ul class="mb-0">
                                        @foreach (var acierto in Model.ListaAciertos)
                                        {
                                            <li>@acierto</li>
                                        }
                                    </ul>
                                </div>
                            }

                            <!-- Mostrar Errores -->
                            @if (Model.ListaErrores != null && Model.ListaErrores.Any())
                            {
                                <div class="alert alert-danger">
                                    <ul class="mb-0">
                                        @foreach (var error in Model.ListaErrores)
                                        {
                                            <li>@error</li>
                                        }
                                    </ul>
                                </div>
                            }

                            @using (Html.BeginForm("Inscripciones", "Home", FormMethod.Post, new { id = "inscripcionForm" }))
                            {
                                <div class="mb-3">
                                    @Html.LabelFor(m => m.Nombre, "Nombre *", new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", required = "required" })
                                </div>

                                <div class="mb-3">
                                    @Html.LabelFor(m => m.Apellido1, "Primer Apellido *", new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.Apellido1, new { @class = "form-control", required = "required" })
                                </div>

                                <div class="mb-3">
                                    @Html.LabelFor(m => m.Apellido2, "Segundo Apellido (opcional)", new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.Apellido2, new { @class = "form-control" })
                                </div>

                                <div class="mb-3">
                                    @Html.LabelFor(m => m.Grado, "Grado *", new { @class = "form-label" })
                                    @Html.DropDownListFor(m => m.Grado,
                                        new SelectList(new[] { "Sétimo", "Octavo", "Noveno", "Décimo", "Undécimo" }),
                                        "Seleccione grado", new { @class = "form-select", required = "required" })
                                </div>

                                <div class="mb-3">
                                    @Html.LabelFor(m => m.Seccion, "Sección *", new { @class = "form-label" })
                                    @Html.DropDownListFor(m => m.Seccion,
                                        new SelectList(Enumerable.Range(1, 11)),
                                        "Seleccione sección", new { @class = "form-select", required = "required" })
                                </div>

                                <div class="mb-3">
                                    @Html.LabelFor(m => m.Correo, "Correo electrónico *", new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", type = "email", required = "required" })
                                </div>

                                <div class="form-check mb-3">
                                    @Html.CheckBoxFor(m => m.Confirmado, new { @class = "form-check-input", required = "required" })
                                    @Html.LabelFor(m => m.Confirmado, "Estoy de acuerdo con que mi hijo participe en el curso de robótica LEGO y entiendo que su información será usada únicamente para fines del curso.", new { @class = "form-check-label" })
                                </div>

                                <p class="small text-muted">
                                    Sus datos serán usados únicamente para el proceso de inscripción.
                                </p>

                                <button type="submit" class="btn btn-info text-white w-100 fw-bold">Enviar Inscripción</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Scripts -->
        <script src="~/Scripts/bootstrap.bundle.min.js"></script>
        <script src="~/Scripts/main.js"></script>

    </body>
</html>