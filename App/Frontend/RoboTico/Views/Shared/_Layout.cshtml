<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewBag.Title - RoboTico</title>

        <!-- Bootstrap 5 -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

        <!-- CSS propio -->
        <link rel="stylesheet" href="~/styles/style.css" />

        <!-- Favicon -->
        <link rel="icon" href="~/img/Logo RoboTico 4.png" type="image/png">
    </head>
    <body>
        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm fixed-top">
            <div class="container">
                <a class="navbar-brand fw-bold text-info" href="@Url.Action("Index", "Home")">
                    <img src="~/img/Logo RoboTico 2.png" alt="Logo" width="125" class="me-2">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" aria-current="page" href="@Url.Action("Index", "Home")">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" href="@Url.Action("Inscripciones", "Home")">Inscripción</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" href="@Url.Action("Info", "Home")">Información</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Renderiza el contenido de cada vista -->
        <main style="margin-top:80px">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="bg-dark text-white text-center py-4 mt-5">
            <div class="container">
                <p>Liceo de San Isidro, Heredia, Costa Rica</p>
                <p>
                    @Html.ActionLink("Inicio", "Index", "Home") |
                    @Html.ActionLink("Inscripción", "Inscripciones", "Home") |
                    @Html.ActionLink("Información", "Info", "Home")
                </p>
                <p class="mt-2">&copy; @DateTime.Now.Year Curso Robótica LEGO EV3 — Universidad Latina de Costa Rica</p>
            </div>
        </footer>

        <!-- Scripts -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/Scripts/indexCromatic.js"></script>
        @RenderSection("scripts", required: false)
    </body>
</html>